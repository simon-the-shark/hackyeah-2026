# Copy to .env (git-ignored). Never commit real values.
PORT=8787
DATABASE_URL=postgres://elder:elder@localhost:5432/elder_care

# pushkit (default, real HarmonyOS Push Kit) | log (explicit opt-in, simulated)
PUSH_PROVIDER=log
# Required when PUSH_PROVIDER=pushkit: service-account key JSON from AppGallery Connect (git-ignored path)
PUSH_KIT_KEY_FILE=

# Seconds without a heartbeat before a monitoring_lost alert is raised.
# Default is unvalidated against real use; keep the app heartbeat interval <= 1/3 of this.
HEARTBEAT_STALE_SECONDS=900

# Minutes after a scheduled dose (or its latest snooze) before it counts as missed
DOSE_MISSED_GRACE_MINUTES=60

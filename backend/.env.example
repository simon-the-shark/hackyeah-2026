# Copy to .env (git-ignored). Never commit real values.
PORT=8787
DATABASE_URL=postgres://elder:elder@localhost:5432/elder_care

# pushkit (default, real HarmonyOS Push Kit) | log (explicit opt-in, simulated)
PUSH_PROVIDER=log
# Required when PUSH_PROVIDER=pushkit: service-account key JSON from AppGallery Connect (git-ignored path)
PUSH_KIT_KEY_FILE=

# Watchdog pass interval (monitoring_lost, trips, routines, missed doses, push reminders)
WATCHDOG_INTERVAL_MS=30000

# Seconds without a heartbeat before a monitoring_lost alert is raised.
# Default is unvalidated against real use; keep the app heartbeat interval <= 1/3 of this.
HEARTBEAT_STALE_SECONDS=900

# Minutes after a scheduled dose (or its latest snooze) before it counts as missed
DOSE_MISSED_GRACE_MINUTES=60
# Unacknowledged SOS reminder interval (max 3 reminders)
SOS_REPUSH_SECONDS=300
# Heartbeat battery % at or below which a low_battery alert fires (once per discharge)
LOW_BATTERY_PERCENT=15

# Per-IP limits on the unauthenticated endpoints
RATE_LIMIT_BOOTSTRAP_PER_MINUTE=10
RATE_LIMIT_CLAIM_FAILURES_PER_15MIN=10

# Wellbeing check-in assistant: openai (default) | simulated (explicit opt-in: scripted, not AI, no voice)
ASSISTANT_PROVIDER=openai
# Required for ASSISTANT_PROVIDER=openai; without it the assistant endpoints answer 503. Never commit it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Hands-free voice (Realtime API, speech to speech over a WebSocket)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# Minutes without activity after which the watchdog finishes an open check-in and sends its report
WELLBEING_IDLE_MINUTES=20
# Paid assistant calls (start, message, transcription, finish, speech) per senior and hour
RATE_LIMIT_ASSISTANT_PER_HOUR=120
